# Env var reference. Copy to .env (local dev) — never commit real values.
# See DEPLOYMENT.md §3 for the authoritative table and README.md for how to
# obtain each value when setting up a new Supabase/Render project.

# --- Runtime -----------------------------------------------------------
NODE_ENV=development
# Public base URL of the app. Used for links in emails, CSRF Origin checks,
# and the resume-link email. In production this is the Render/custom domain.
APP_BASE_URL=http://localhost:3000

# --- Database (Supabase Postgres) --------------------------------------
# Supavisor POOLER connection string (transaction mode, port 6543), using the
# least-privilege `app_user` role created by migration 0001 — NEVER the
# `postgres` superuser or the Supabase `service_role`.
# Get it from: Supabase dashboard -> Project Settings -> Database -> Connection
# string (Transaction pooler), then swap the user/password for app_user's
# (set via `pnpm db:set-app-password` after running migrations).
DATABASE_URL=postgresql://app_user:CHANGEME@db.PROJECT_REF.supabase.co:6543/postgres?sslmode=require

# Direct (port 5432) connection as the PROJECT OWNER, used only to run
# migrations (`pnpm migrate`, `pnpm admin:add`) and to set app_user's
# password. Kept in the developer's password manager and as a GitHub Actions
# secret for the manual `migrate` workflow. NEVER set this in Render.
# Get it from: Supabase dashboard -> Project Settings -> Database -> Connection
# string (Direct connection).
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGEME@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# --- Supabase Auth + Storage --------------------------------------------
# Project URL. Get it from: Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Service-role key. Used ONLY server-side for: (a) Storage signed URLs for CV
# downloads, (b) Supabase Auth admin invite API. Never exposed to the
# browser, never used for data access (ARCHITECTURE.md §2/§6).
# Get it from: Supabase dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=CHANGEME

# Anon key. Used only by @supabase/ssr for the admin login (Auth) flow, never
# for data. Get it from: Supabase dashboard -> Project Settings -> API -> anon.
SUPABASE_ANON_KEY=CHANGEME

# Optional legacy fallback only. Admin session JWTs are verified locally
# against the project's public JWKS (SUPABASE_URL + "/auth/v1/.well-known/
# jwks.json") — no secret needed for a normal (post-2026) project. Only set
# this if you have an older, HS256-only project with a real "JWT Secret"
# under Project Settings -> API -> JWT Settings.
SUPABASE_JWT_SECRET=

# --- Candidate auth -------------------------------------------------------
# HMAC key for the candidate cookie (app_session). Generate with:
# `openssl rand -base64 32`. Render generates this automatically
# (render.yaml `generateValue: true`) — only needed manually for local dev.
CANDIDATE_COOKIE_SECRET=CHANGEME

# --- Assessment runner (ARCHITECTURE.md §5.2) ------------------------------
# HMAC key for the per-serve item_token (src/lib/item-token.ts). Generate
# with: `openssl rand -base64 32`. Render generates this automatically
# (render.yaml `generateValue: true`) — only needed manually for local dev.
ITEM_TOKEN_SECRET=CHANGEME
# Dev/test only, refused at boot in production: shifts the server's notion
# of "now" for the timed-assessment hot path (src/lib/clock.ts), so e2e
# tests can move item timers forward without waiting real seconds.
# TEST_CLOCK_OFFSET_MS=0

# --- Email (Resend) --------------------------------------------------------
# Required at launch: production boot refuses to start with EMAIL_ENABLED
# other than "true" (DECISIONS_LOG.md #2; ARCHITECTURE.md §1). The resume
# code still works without email; OTP re-entry and closure emails do not.
EMAIL_ENABLED=true
# Get it from: https://resend.com dashboard -> API Keys (after verifying the
# sending domain's DNS records).
RESEND_API_KEY=CHANGEME
# Display name + address used as the "From" header, e.g. "גיוס <jobs@example.co.il>"
EMAIL_FROM="גיוס <jobs@example.co.il>"
# Shown to candidates in the privacy notice and error copy for data requests.
PRIVACY_CONTACT_EMAIL=privacy@example.co.il

# --- Alerting ----------------------------------------------------------
# Required in production: boot refuses to start without it (alerting must
# never be silently off). Get it from: https://sentry.io -> Project Settings
# -> Client Keys (DSN).
SENTRY_DSN=CHANGEME
# Hiring manager's address. Used to configure the Sentry "new issue" alert
# rule and the UptimeRobot contact, and printed in the admin runbook.
ALERT_EMAIL=manager@example.co.il

# --- Misc ----------------------------------------------------------------
# info | warn | error. Optional, defaults to "info".
LOG_LEVEL=info

# Test-only clock offset (milliseconds) so Playwright/integration tests can
# move server time forward without waiting. Refused (ignored) whenever
# NODE_ENV=production (TEST_STRATEGY.md §1). Never set this in Render.
# TEST_CLOCK_OFFSET_MS=0
